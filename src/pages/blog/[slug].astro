---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getReadingTime } from '../../utils/readingTime';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => {
    const slug = post.id.replace(/\.md$/, '');
    return { params: { slug }, props: { post } };
  });
}

const { post } = Astro.props;
const canonicalURL = new URL(`/blog/${Astro.params.slug}`, Astro.site);
const { Content } = await render(post);
const readingTime = getReadingTime(post.body);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  author: {
    '@type': 'Person',
    name: 'Kush Saraiya',
    url: 'https://kushsaraiya.com'
  },
  datePublished: post.data.pubDatetime,
  dateModified: post.data.modDatetime || post.data.pubDatetime,
  image: post.data.banner
    ? `https://kushsaraiya.com${post.data.banner}`
    : undefined,
  url: canonicalURL.toString(),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.toString()
  },
  publisher: {
    '@type': 'Person',
    name: 'Kush Saraiya',
    url: 'https://kushsaraiya.com'
  }
};
---

<BaseLayout
  title={post.data.title}
  canonicalUrl={canonicalURL.toString()}
  ogImage={post.data.banner}
  description={post.data.description}
  schema={schema}
>
  <a href="/writing" class="back-link">← Writing</a>
  <div class="post-header">
    <h1>{post.data.title}</h1>
    {
      post.data.pubDatetime && (
        <p class="post-meta">
          {new Date(post.data.pubDatetime).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric'
          })}{' '}
          · {readingTime} min read
        </p>
      )
    }
  </div>
  <div class="prose">
    {
      post.data.banner && (
        <img src={post.data.banner} alt={post.data.title} class="post-banner" />
      )
    }
    <Content />
  </div>
</BaseLayout>
