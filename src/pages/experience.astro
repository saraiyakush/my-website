---
import BaseLayout from '../layouts/BaseLayout.astro';

const experiences = [
  {
    company: 'Technogise, Pune',
    role: 'Lead Technology Consultant',
    period: 'Jan 2022 - Present',
    achievements: [
      'Designed and delivered the CI/CD, observability, and operational tooling for a greenfield multi-market vendor integration platform, reducing lead time for change to 30 minutes while maintaining a change failure rate below 10%.',
      'Spearheaded large-scale Java 7 to Java 17 migration across 100+ services by leveraging AI-assisted workflows and containerisation, completing in 3 weeks instead of months.',
      'Introduced and scaled pragmatic XP practices (TDD, BDD) across 35 engineers and 4 teams, establishing consistent quality and testing standards.',
      "Led the initiative that secured Technogise's first AWS Partnership badge within 8 months by creating the certification programme, operational model, and budget framework that enabled 10 engineers to achieve AWS certifications."
    ]
  },
  {
    company: 'xEnabler, Pune',
    role: 'Engineering Manager',
    period: 'Jan 2021 - Jan 2022',
    achievements: [
      'Introduced engineering practices such as TDD and CI/CD for backend teams of 15 engineers, enabling shift-left testing and reducing escaped defects by 60%.',
      'Drove DevOps transformation initiatives across 3 projects, standardising deployment across engineering teams.'
    ]
  },
  {
    company: 'Infosys Limited, Pune & USA',
    role: 'Technology Lead',
    period: 'Feb 2012 - Jan 2021',
    achievements: [
      'Reduced infrastructure costs by 75% through architectural redesign of compliance workflows.',
      'Delivered a fault-tolerant batch processing system, reducing recurring production incidents from 3 per month to 0.'
    ]
  },
  {
    company: 'Tata Consultancy Services, Ahmedabad',
    role: 'Systems Engineer',
    period: 'Jul 2008 - Jan 2012',
    achievements: [
      'Developed enterprise applications for Government of Cardiff and Government of Gujarat.',
      'Built internal utility frameworks to improve consistency and reduce boilerplate.',
      'Progressed to Module Lead, owning end-to-end SDLC.',
      "Nominated for 'Employee Star of the Month' (Dec 2010)."
    ]
  }
];
---

<BaseLayout title="Experience">
  <h1>Experience</h1>
  <p>
    From systems engineer to lead consultant — 17+ years across distributed
    systems, platform engineering, and team development.
  </p>
  <div class="timeline">
    {
      experiences.map((exp) => (
        <div class="timeline-item">
          <div class="timeline-marker" />
          <div class="timeline-content">
            <div class="timeline-header">
              <div>
                <h2>{exp.role}</h2>
                <h3>{exp.company}</h3>
              </div>
              <span class="timeline-date">{exp.period}</span>
            </div>
            <ul>
              {exp.achievements.map((achievement) => (
                <li>{achievement}</li>
              ))}
            </ul>
          </div>
        </div>
      ))
    }
  </div>
</BaseLayout>
