---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../utils/readingTime';

const posts = (await getCollection('blog'))
  .sort((a, b) => {
    const dateA = a.data.pubDatetime
      ? new Date(a.data.pubDatetime).getTime()
      : 0;
    const dateB = b.data.pubDatetime
      ? new Date(b.data.pubDatetime).getTime()
      : 0;
    return dateB - dateA;
  })
  .slice(0, 3);
---

<BaseLayout
  title="Kush Saraiya"
  description="Lead Technology Consultant at Technogise. Software architect and engineer. Writing about engineering judgement, trade-offs, and system design."
>
  <div class="hero">
    <p class="hero-name">Kush Saraiya</p>
    <h1 class="hero-tagline">
      <span class="highlight">Judgement</span> over hype.<br />
      <span class="highlight">Trade-offs</span> over trends.
    </h1>
    <p class="hero-sub">
      Distributed systems · Platform modernisation · Engineering effectiveness
    </p>
    <p class="hero-domain">17+ years as engineer, architect, and mentor</p>
  </div>

  <div class="writing-section">
    <div class="section-header">
      <h2 class="section-label">Recent thinking</h2>
      <a href="/rss.xml" class="rss-link" aria-label="RSS Feed" target="_blank">
        <span>RSS</span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
          ><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"
          ></path><circle cx="5" cy="19" r="1"></circle></svg
        >
      </a>
    </div>
    <ul class="post-list">
      {
        posts.map((post) => {
          const readingTime = getReadingTime(post.body);
          return (
            <li>
              <a
                href={`/blog/${post.id.replace(/\.md$/, '')}`}
                class="post-link"
              >
                <div class="post-row">
                  <span>{post.data.title}</span>
                  {post.data.pubDatetime && (
                    <span class="post-date">
                      {new Date(post.data.pubDatetime).toLocaleDateString(
                        'en-US',
                        {
                          month: 'short',
                          year: 'numeric',
                          day: 'numeric'
                        }
                      )}{' '}
                      · {readingTime} min read
                    </span>
                  )}
                </div>
                {post.data.description && (
                  <p class="post-desc">{post.data.description}</p>
                )}
              </a>
            </li>
          );
        })
      }
    </ul>
    <a href="/writing" class="all-writing-link">All articles →</a>
  </div>

  <p class="cta-plain">
    Working on something complex? <a href="/contact">Let's talk</a>
  </p>
</BaseLayout>
