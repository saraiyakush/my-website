---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => {
    const dateA = a.data.pubDatetime ? new Date(a.data.pubDatetime).getTime() : 0;
    const dateB = b.data.pubDatetime ? new Date(b.data.pubDatetime).getTime() : 0;
    return dateB - dateA;
  })
  .slice(0, 5);
---

<BaseLayout title="Kush Saraiya">
  <div class="home-intro">
    <h1>Judgment over hype.<br>Trade-offs over trends.</h1>
    <p class="hero-sub">Engineer · Architect · Mentor · 17+ years in software</p>
  </div>

  <div class="writing-section">
    <h2>Latest articles</h2>
    <ul class="post-list">
      {posts.map(post => (
        <li>
          <a href={`/blog/${post.id.replace(/\.md$/, '')}`}>
            <span>{post.data.title}</span>
            {post.data.pubDatetime && (
              <span class="post-date">
                {new Date(post.data.pubDatetime).toLocaleDateString('en-US', {
                  month: 'short', year: 'numeric', day: 'numeric'
                })}
              </span>
            )}
          </a>
          {post.data.description && (
            <p class="post-desc">{post.data.description}</p>
          )}
        </li>
      ))}
    </ul>
    <a href="/writing" class="all-writing-link">All articles →</a>
  </div>
</BaseLayout>