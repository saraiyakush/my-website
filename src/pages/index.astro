---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => {
    const dateA = a.data.pubDatetime ? new Date(a.data.pubDatetime).getTime() : 0;
    const dateB = b.data.pubDatetime ? new Date(b.data.pubDatetime).getTime() : 0;
    return dateB - dateA;
  })
  .slice(0, 5);
---

<BaseLayout title="Kush Saraiya">
  <div class="home-intro">
    <h1>Engineer. Architect. Mentor.</h1>
    <p class="tagline">Judgment over hype, trade-offs over trends.</p>
    <p>
      17+ years of building and guiding software systems. I help teams design
      systems that scale — technically, organisationally, and ethically.
    </p>
  </div>

  <div class="writing-section">
    <h2>Recent writing</h2>
    <ul class="post-list">
      {posts.map(post => (
        <li>
          <a href={`/blog/${post.id.replace(/\.md$/, '')}`}>
            <span>{post.data.title}</span>
            {post.data.pubDatetime && (
              <span class="post-year">
                {new Date(post.data.pubDatetime).getFullYear()}
              </span>
            )}
          </a>
        </li>
      ))}
    </ul>
    <a href="/writing" class="all-writing-link">All articles →</a>
  </div>
</BaseLayout>