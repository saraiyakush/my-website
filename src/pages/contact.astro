---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout
  title="Contact"
  description="Get in touch for thoughtful conversations about software, architecture, and engineering"
>
  <h2>Open to thoughtful conversations</h2>

  <p>
    Whether you're navigating complex technical decisions, thinking beyond
    implementation in system design, exploring engineering growth, or reflecting
    on technology and its real-world impact — feel free to reach out.
  </p>

  <p>I typically respond within 24-48 hours.</p>

  <h2>You can find me here:</h2>

  <div class="contact-links">
    <a href="mailto:hello@kushsaraiya.com">
      <Icon name="mdi:email-outline" />
      <span>Email</span>
    </a>
    <a
      href="https://linkedin.com/in/kushsaraiya"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name="mdi:linkedin" />
      <span>LinkedIn</span>
    </a>
    <a
      href="https://github.com/saraiyakush"
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name="mdi:github" />
      <span>GitHub</span>
    </a>
  </div>
</BaseLayout>
