---
import '../styles/global.css';
const { title, canonicalUrl, ogImage, description, schema } = Astro.props;
const canonical =
  canonicalUrl ?? `https://kushsaraiya.com${Astro.url.pathname}`;
const fullOgImage = ogImage ? `https://kushsaraiya.com${ogImage}` : null;
const currentPath = Astro.url.pathname;
---

<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>
      {title === 'Kush Saraiya' ? title : `${title} | Kush Saraiya`}
    </title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kush Saraiya" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta name="description" content={description} />}
    {description && <meta property="og:description" content={description} />}
    {
      fullOgImage && (
        <>
          <meta property="og:image" content={fullOgImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={fullOgImage} />
        </>
      )
    }
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:title" content={title} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,600;0,700;1,400&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono&display=swap"
      rel="stylesheet"
    />
    {
      title === 'Kush Saraiya' && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'Person',
            name: 'Kush Saraiya',
            url: 'https://kushsaraiya.com',
            jobTitle: 'Lead Technology Consultant',
            description:
              'Engineer, Architect, and Mentor with 17+ years in software development',
            sameAs: [
              'https://www.linkedin.com/in/kushsaraiya',
              'https://kush-saraiya.medium.com/',
              'https://github.com/saraiyakush/'
            ]
          })}
        />
      )
    }
    {
      schema && (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      )
    }
    <!-- Cloudflare Web Analytics -->
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "2ccdd36793fc429e80f3a8fe65b7bb28"}'
    ></script><!-- End Cloudflare Web Analytics -->
  </head>

  <body>
    <nav>
      <a href="/" class="site-name">Kush Saraiya</a>
      <ul>
        <li>
          <a href="/writing" aria-current={currentPath.startsWith('/writing') || currentPath.startsWith('/blog') ? 'page' : undefined}>Writing</a>
        </li>
        <li>
          <a href="/talks" aria-current={currentPath.startsWith('/talks') ? 'page' : undefined}>Talks</a>
        </li>
        <li>
          <a href="/experience" aria-current={currentPath.startsWith('/experience') ? 'page' : undefined}>Experience</a>
        </li>
        <li>
          <a href="/about" aria-current={currentPath.startsWith('/about') ? 'page' : undefined}>About</a>
        </li>
        <li>
          <a href="/contact" aria-current={currentPath.startsWith('/contact') ? 'page' : undefined}>Contact</a>
        </li>
        <li>
          <button id="theme-toggle" aria-label="Toggle dark mode">
            <svg
              class="sun-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <svg
              class="moon-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </li>
      </ul>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      &copy; {new Date().getFullYear()} Kush Saraiya
    </footer>

    <script src="/src/scripts/theme-toggle.js"></script>
  </body>
</html>
