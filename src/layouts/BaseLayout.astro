---
import '../styles/global.css';
const { title, canonicalUrl, ogImage, description } = Astro.props;
const canonical =
  canonicalUrl ?? `https://kushsaraiya.com${Astro.url.pathname}`;
const fullOgImage = ogImage ? `https://kushsaraiya.com${ogImage}` : null;
---

<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      {title === 'Kush Saraiya' ? title : `${title} | Kush Saraiya`}
    </title>
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {
      fullOgImage && (
        <>
          <meta property="og:image" content={fullOgImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:image" content={fullOgImage} />
        </>
      )
    }
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:title" content={title} />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,600;0,700;1,400&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono&display=swap"
      rel="stylesheet"
    />
    <!-- Cloudflare Web Analytics -->
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "2ccdd36793fc429e80f3a8fe65b7bb28"}'
    ></script><!-- End Cloudflare Web Analytics -->
  </head>

  <body>
    <nav>
      <a href="/" class="site-name">Kush Saraiya</a>
      <ul>
        <li>
          <a href="/">Home</a>
        </li>
        <li>
          <a href="/writing">Writing</a>
        </li>
        <li>
          <a href="/talks">Talks</a>
        </li>
        <li>
          <a href="/about">About</a>
        </li>
        <li>
          <a href="/contact">Contact</a>
        </li>
      </ul>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      &copy; {new Date().getFullYear()} Kush Saraiya
    </footer>
  </body>
</html>
