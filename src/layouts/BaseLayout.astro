---
import '../styles/global.css';
const { title, canonicalUrl } = Astro.props;
const canonical =
  canonicalUrl ?? `https://kushsaraiya.com${Astro.url.pathname}`;
---

<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      {title === 'Kush Saraiya' ? title : `${title} | Kush Saraiya`}
    </title>
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,400;0,600;0,700;1,400&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <nav>
      <a href="/" class="site-name">Kush Saraiya</a>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/writing">Writing</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      &copy; {new Date().getFullYear()} Kush Saraiya
    </footer>
  </body>
</html>
